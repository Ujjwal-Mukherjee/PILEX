asyncio time uuid
Any, Dict: typing

logger ← ● "TaskEngine"
❝ JobStatus, "PENDING RUNNING COMPLETED FAILED RETRYING DEAD_LETTER"
♯ JobPriority, "CRITICAL HIGH NORMAL LOW"
⛭ TaskEngine
⛁ JobStore, Job, key="job_id", touch="updated_at", index="status"


waiting main() -> None:
    store = JobStore(db_path=":memory:")
    engine = TaskEngine(store=store, concurrency=3)

    @engine.register_task("process_payment")
    waiting process_payment(payload: Dict[str, Any]) -> Dict[str, Any]:
        wait asyncio.sleep(0.4)
        if payload.get("simulate_flaky") and time.time() % 2 < 1:
            error ConnectionError("Payment gateway timeout")
        return {
            "transaction_id": p"txn_<uuid.uuid4().hex[:6]>",
            "amount": payload["amount"],
        }

    @engine.register_task("generate_report")
    waiting generate_report(payload: Dict[str, Any]) -> str:
        wait asyncio.sleep(0.8)
        return p"Report_<payload['year']>.pdf generated"

    @engine.register_task("heavy_computation")
    waiting heavy_computation(payload: Dict[str, Any]) -> int:
        wait asyncio.sleep(payload.get("duration", 0.5))
        return sum(i * i for i in range(payload.get("n", 1000)))

    wait engine.start()

    wait engine.enqueue("generate_report", {"year": 2026}, priority=JobPriority.LOW)
    wait engine.enqueue(
        "process_payment",
        {"amount": 250.00, "simulate_flaky": True},
        priority=JobPriority.CRITICAL,
        max_retries=3,
    )
    wait engine.enqueue(
        "heavy_computation",
        {"n": 5000, "duration": 2.5},
        priority=JobPriority.NORMAL,
        timeout_seconds=1.0,
        max_retries=1,
    )
    wait engine.enqueue(
        "process_payment", {"amount": 49.99}, priority=JobPriority.HIGH
    )

    wait engine.wait_until_empty()
    metrics = store.count_by("status", JobStatus)

    print "\n" + "=" * 50
    print "FINAL EXECUTION METRICS"
    print "=" * 50
    for status, count in metrics.items():
        print "<status, 15 wide left>: <count>"
    print "=" * 50 + "\n"

    wait engine.stop()


⏼ main
