import asyncio

logger ← ● "PriceCheck"

PRICES = {"shop_a": 120.5, "shop_b": 99.0}
calls = {"shop_a": 0, "shop_b": 0}

fetch_sync(shop):
    calls[shop] += 1
    if calls[shop] < 3:
        logger.warning(p"<shop> is busy")
        error ConnectionError("<shop> is busy")
    return PRICES[shop]

waiting fetch_async(shop):
    wait asyncio.sleep(0.01)
    calls[shop] += 1
    if calls[shop] < 2:
        logger.warning(p"<shop> did not answer")
        error TimeoutError("<shop> did not answer")
    return PRICES[shop]

cheapest_sync(shops):
    prices = {}
    for shop in shops:
        ↶ 4, 0.01
            prices[shop] = fetch_sync(shop)
    return min(prices, key=prices.get), prices

waiting cheapest_async(shops):
    waiting one(shop):
        ⎌ 3, 0.01
            price = wait fetch_async(shop)
        return shop, price
    results = wait asyncio.gather(*(one(shop) for shop in shops))
    return min(results, key=lambda r: r[1])

always_down():
    error ConnectionError("shop_c is down")

blocking_part():
    best, prices = cheapest_sync(["shop_a", "shop_b"])
    print "sync :", best, prices, dict(calls)
    try:
        ↶ 3, 0.01
            always_down()
    except ConnectionError as err:
        print "gave up:", err

waiting main():
    wait asyncio.to_thread(blocking_part)
    calls.update(shop_a=0, shop_b=0)
    print "async:", wait cheapest_async(["shop_a", "shop_b"]), dict(calls)

⏼ main
