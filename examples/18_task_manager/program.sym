"""A small task manager for the terminal.

The tasks are kept in a file called tasks.json, so they are still there the next time the program runs.
"""

from pathlib import Path

TASK_FILE = Path("tasks.json")

MENU = """
1  Add a task
2  Show the tasks
3  Mark a task as done
4  Delete a task
5  Quit"""


is_valid(task):
    """A task in the file must be a number above zero, a title and a done flag."""
    return (
        isinstance(task, dict)
        and type(task.get("id")) is int
        and task["id"] > 0
        and isinstance(task.get("title"), str)
        and isinstance(task.get("done"), bool)
    )


class TaskManager:
    __init__(self, path):
        self.path = path
        self.tasks = self.load()

    load(self):
        """Read the tasks from the file. A file that is not there means there are no tasks yet."""
        tasks ← ⎰ self.path, []
        if not isinstance(tasks, list) or not all(is_valid(task) for task in tasks):
            error "the file does not hold a proper list of tasks"
        if len({task["id"] for task in tasks}) != len(tasks):
            error "two tasks have the same number"
        return tasks

    save(self):
        """Write a temporary file first, so a failed save cannot damage the old file."""
        text ← ⏟ self.tasks, 2
        ⇟ str(self.path), text

    find(self, task_id):
        task ← ⌖ self.tasks, "id", task_id
        return task

    add(self, title):
        task_id ← ≻ self.tasks
        self.tasks.append({"id": task_id, "title": title, "done": False})
        self.save()
        return task_id

    complete(self, task_id):
        """Mark a task as done. The answer is False when there is no task with that number."""
        task = self.find(task_id)
        if task is None:
            return False
        task["done"] = True
        self.save()
        return True

    delete(self, task_id):
        """Remove a task. The answer is False when there is no task with that number."""
        task = self.find(task_id)
        if task is None:
            return False
        self.tasks.remove(task)
        self.save()
        return True

    show(self):
        if not self.tasks:
            print "There are no tasks yet."
            return
        for task in self.tasks:
            mark = "x" if task["done"] else " "
            print "<task['id'], 3 wide right>  [<mark>]  <task['title']>"
        finished = sum(task["done"] for task in self.tasks)
        print "<finished> of <len(self.tasks)> done"


ask_task_number():
    """Keep asking until the person types a whole number above zero."""
    number ← ⍰ "Task number: ", int, 1, "Please type a whole number above zero."
    return number


run_menu(manager):
    add_task():
        title = input("Title: ").strip()
        if title:
            print "Added task <manager.add(title)>."
        else:
            print "A task needs a title."

    complete_task():
        if manager.complete(ask_task_number()):
            print "Marked as done."
        else:
            print "There is no task with that number."

    delete_task():
        if manager.delete(ask_task_number()):
            print "Deleted."
        else:
            print "There is no task with that number."

    say_goodbye():
        print "Goodbye."

    actions = {"1": add_task, "2": manager.show, "3": complete_task, "4": delete_task, "5": say_goodbye}
    ◉ MENU, actions, "5", "Please choose a number from 1 to 5."


main():
    try:
        manager = TaskManager(TASK_FILE)
    except (OSError, ValueError) as error:
        print "Cannot read <TASK_FILE>: <error>"
        return
    try:
        run_menu(manager)
    except OSError as error:
        print "Could not save the tasks: <error>"
    except (EOFError, KeyboardInterrupt):
        print "\nGoodbye."


➤ main
